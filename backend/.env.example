# Ambiente
APP_ENV=development
APP_TZ=America/Sao_Paulo

# Servidor
MONGO_URL=mongodb://localhost:27017
DB_NAME=gestao_esportiva_escolar
APP_PORT=8000
APP_HOST=0.0.0.0
APP_URL=

# Segurança — GERE VALORES ÚNICOS DE 32+ BYTES (ex: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=
CSRF_HMAC_SECRET=
DOCUMENT_HMAC_SECRET=
COOKIE_SECURE=false
STATELESS_CSRF=true
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
FRONTEND_URL=http://localhost:5173

# Integrações
GOOGLE_CLIENT_ID=
EMERGENT_EMAIL_KEY=
EMAIL_FROM_NAME=Gestão Esportiva Escolar
EMERGENT_LLM_KEY=
# PERPLEXITY_API_KEY=

# Admin raiz gerenciado pelo ambiente: criado/sincronizado a cada boot (services/root_admin.py).
# ADMIN_USER precisa ser um e-mail; ADMIN_PASSWORD com 10+ caracteres. Em produção, use um Environment Group no Render.
ADMIN_USER=
ADMIN_PASSWORD=
# Bootstrap legado por script (a API não lê estas variáveis; remova ROOT_ADMIN_PASSWORD após rodar backend/scripts/bootstrap_root_admin.py)
ROOT_ADMIN_EMAIL=
ROOT_ADMIN_NAME=Administrador raiz
ROOT_ADMIN_PASSWORD=
