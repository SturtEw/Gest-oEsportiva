      "html": "<style>\n    @import url(\"https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap\");@import url(\"https://cdn.jsdelivr.net/npm/@phosphor-icons/web@2.1.1/src/regular/style.css\");\n</style>\n<div class=\"min-h-screen bg-[#f4f6f1] text-[#172b27] font-['DM_Sans',sans-serif]\" data-kid=\"1\">\n    <div class=\"flex min-h-screen\" data-kid=\"1-1\">\n        <aside class=\"flex w-[242px] shrink-0 flex-col bg-[#153b34] px-5 py-6 text-white\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-3 px-2\" data-kid=\"1-1-1-1\">\n                <div class=\"flex h-10 w-10 items-center justify-center rounded-xl border border-white/15 bg-white/10 font-['Manrope',sans-serif] text-sm font-extrabold tracking-[-0.05em] text-[#c7e78a]\" data-kid=\"1-1-1-1-1\">\n                    GE\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <div class=\"font-['Manrope',sans-serif] text-[13px] font-extrabold leading-tight tracking-[0.03em]\" data-kid=\"1-1-1-1-2-1\">\n                        GESTÃO ESPORTIVA\n                    </div>\n                    <div class=\"mt-0.5 text-[10px] font-medium uppercase tracking-[0.2em] text-white/55\" data-kid=\"1-1-1-1-2-2\">\n                        escolar\n                    </div>\n                </div>\n            </div>\n            <div class=\"mt-10 px-3 text-[10px] font-bold uppercase tracking-[0.16em] text-white/40\" data-kid=\"1-1-1-2\">\n                Espaço do professor\n            </div>\n            <nav aria-label=\"Navegação principal\" class=\"mt-3 flex flex-col gap-1\" data-kid=\"1-1-1-3\">\n                <a aria-current=\"page\" class=\"flex items-center gap-3 rounded-xl bg-[#d9efab] px-3 py-3 text-[13px] font-bold text-[#183c32]\" data-kid=\"1-1-1-3-1\" href=\"#\">\n                    <i class=\"ph ph-squares-four text-lg\" data-kid=\"1-1-1-3-1-1\" style=\"color:#183c32;width:20px;height:20px\">\n                    </i>\n                    Painel inicial\n                </a>\n                <a class=\"flex items-center gap-3 rounded-xl px-3 py-3 text-[13px] font-medium text-white/70\" data-kid=\"1-1-1-3-2\" href=\"#\">\n                    <i class=\"ph ph-users-three text-lg\" data-kid=\"1-1-1-3-2-1\" style=\"color:#cbd8d2;width:20px;height:20px\">\n                    </i>\n                    Minhas turmas\n                </a>\n                <a class=\"flex items-center gap-3 rounded-xl px-3 py-3 text-[13px] font-medium text-white/70\" data-kid=\"1-1-1-3-3\" href=\"#\">\n                    <i class=\"ph ph-calendar-check text-lg\" data-kid=\"1-1-1-3-3-1\" style=\"color:#cbd8d2;width:20px;height:20px\">\n                    </i>\n                    Chamadas\n                </a>\n                <a class=\"flex items-center gap-3 rounded-xl px-3 py-3 text-[13px] font-medium text-white/70\" data-kid=\"1-1-1-3-4\" href=\"#\">\n                    <i class=\"ph ph-chart-line-up text-lg\" data-kid=\"1-1-1-3-4-1\" style=\"color:#cbd8d2;width:20px;height:20px\">\n                    </i>\n                    Avaliações\n                </a>\n                <a class=\"flex items-center gap-3 rounded-xl px-3 py-3 text-[13px] font-medium text-white/70\" data-kid=\"1-1-1-3-5\" href=\"#\">\n                    <i class=\"ph ph-chat-circle-dots text-lg\" data-kid=\"1-1-1-3-5-1\" style=\"color:#cbd8d2;width:20px;height:20px\">\n                    </i>\n                    Comunicados\n                </a>\n            </nav>\n            <div class=\"mt-auto rounded-2xl border border-white/10 bg-white/[0.06] p-4\" data-kid=\"1-1-1-4\">\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-1-4-1\">\n                    <div class=\"flex h-9 w-9 items-center justify-center rounded-full bg-[#e8cda5] text-xs font-bold text-[#4b3526]\" data-kid=\"1-1-1-4-1-1\">\n                        RA\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-1-1-4-1-2\">\n                        <div class=\"truncate text-[13px] font-semibold\" data-kid=\"1-1-1-4-1-2-1\">\n                            Rafael Alves\n                        </div>\n                        <div class=\"mt-0.5 text-[11px] text-white/55\" data-kid=\"1-1-1-4-1-2-2\">\n                            Professor\n                        </div>\n                    </div>\n                    <i class=\"ph ph-caret-down ml-auto text-sm\" data-kid=\"1-1-1-4-1-3\" style=\"color:#a9bbb4;width:16px;height:16px\">\n                    </i>\n                </div>\n            </div>\n        </aside>\n        <main class=\"min-w-0 flex-1 px-9 pb-10 pt-7\" data-kid=\"1-1-2\">\n            <header class=\"flex items-center justify-between border-b border-[#dfe5dc] pb-5\" data-kid=\"1-1-2-1\">\n                <div data-kid=\"1-1-2-1-1\">\n                    <div class=\"text-[12px] font-medium text-[#72817a]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-1\" data-name=\"current date text\" data-reason=\"date updated automatically to current day\">\n                        Quinta-feira, 24 de setembro de 2026\n                    </div>\n                    <div class=\"mt-1 text-[14px] font-semibold text-[#30453e]\" data-dynamic=\"true\" data-kid=\"1-1-2-1-1-2\" data-name=\"welcome greeting with sun icon\" data-reason=\"greeting updated based on current time\">\n                        Bom dia, Rafael\n                        <span aria-hidden=\"true\" data-kid=\"1-1-2-1-1-2-1\">\n                            ☀\n                        </span>\n                    </div>\n                </div>\n                <div class=\"flex items-center gap-3\" data-kid=\"1-1-2-1-2\">\n                    <button aria-label=\"Notificações\" class=\"relative flex h-10 w-10 items-center justify-center rounded-full border border-[#dfe5dc] bg-white text-[#52665d]\" data-kid=\"1-1-2-1-2-1\">\n                        <i class=\"ph ph-bell text-lg\" data-kid=\"1-1-2-1-2-1-1\" style=\"color:#52665d;width:20px;height:20px\">\n                        </i>\n                        <span class=\"absolute right-[9px] top-[8px] h-1.5 w-1.5 rounded-full bg-[#e68c5b]\" data-kid=\"1-1-2-1-2-1-2\">\n                        </span>\n                    </button>\n                    <div class=\"flex items-center gap-2 rounded-full bg-white px-3 py-2\" data-kid=\"1-1-2-1-2-2\">\n                        <div class=\"h-7 w-7 rounded-full bg-[url('https://i.pravatar.cc/80?u=rafael-esporte')] bg-cover bg-center\" data-kid=\"1-1-2-1-2-2-1\">\n                        </div>\n                        <span class=\"text-[12px] font-semibold text-[#33473f]\" data-kid=\"1-1-2-1-2-2-2\">\n                            Rafael Alves\n                        </span>\n                        <i class=\"ph ph-caret-down text-sm\" data-kid=\"1-1-2-1-2-2-3\" style=\"color:#77857d;width:16px;height:16px\">\n                        </i>\n                    </div>\n                </div>\n            </header>\n            <section class=\"mt-7 flex items-end justify-between gap-5\" data-kid=\"1-1-2-2\">\n                <div data-kid=\"1-1-2-2-1\">\n                    <div class=\"flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.16em] text-[#74837a]\" data-kid=\"1-1-2-2-1-1\">\n                        <span data-kid=\"1-1-2-2-1-1-1\">\n                            Professor\n                        </span>\n                        <span class=\"text-[#b0bbb3]\" data-kid=\"1-1-2-2-1-1-2\">\n                            /\n                        </span>\n                        <span data-kid=\"1-1-2-2-1-1-3\">\n                            Futsal sub-14\n                        </span>\n                    </div>\n                    <h1 class=\"mt-2 font-['Manrope',sans-serif] text-[30px] font-extrabold tracking-[-0.045em] text-[#18372f]\" data-kid=\"1-1-2-2-1-2\">\n                        Acompanhar evolução\n                    </h1>\n                    <p class=\"mt-1 text-[13px] text-[#718078]\" data-kid=\"1-1-2-2-1-3\">\n                        Veja o percurso de cada aluno ao longo dos bimestres.\n                    </p>\n                </div>\n                <button class=\"flex items-center gap-3 rounded-xl border border-[#d9e1d8] bg-white px-4 py-3 text-left shadow-[0_2px_6px_rgba(28,57,44,0.03)]\" data-kid=\"1-1-2-2-2\">\n                    <span class=\"flex h-9 w-9 items-center justify-center rounded-lg bg-[#edf4e7]\" data-kid=\"1-1-2-2-2-1\">\n                        <i class=\"ph ph-soccer-ball text-lg\" data-kid=\"1-1-2-2-2-1-1\" style=\"color:#38624e;width:20px;height:20px\">\n                        </i>\n                    </span>\n                    <span data-kid=\"1-1-2-2-2-2\">\n                        <span class=\"block text-[10px] font-bold uppercase tracking-[0.13em] text-[#819087]\" data-kid=\"1-1-2-2-2-2-1\">\n                            Turma selecionada\n                        </span>\n                        <span class=\"mt-0.5 flex items-center gap-2 text-[13px] font-bold text-[#27483b]\" data-kid=\"1-1-2-2-2-2-2\">\n                            Futsal sub-14\n                            <i class=\"ph ph-caret-down text-sm\" data-kid=\"1-1-2-2-2-2-2-1\" style=\"color:#819087;width:15px;height:15px\">\n                            </i>\n                        </span>\n                    </span>\n                </button>\n            </section>\n            <section aria-label=\"Chamada de hoje\" class=\"mt-6 flex items-center justify-between gap-5 rounded-2xl border border-[#ead6ba] bg-[#fffaf1] px-5 py-4 shadow-[0_4px_16px_rgba(68,53,25,0.03)]\" data-dynamic=\"true\" data-kid=\"1-1-2-3\" data-name=\"lesson attendance alert card\" data-reason=\"visibility/text updated if attendance is due\">\n                <div class=\"flex min-w-0 items-center gap-4\" data-kid=\"1-1-2-3-1\">\n                    <div class=\"flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-[#f4e7cc]\" data-kid=\"1-1-2-3-1-1\">\n                        <i class=\"ph ph-clock-countdown text-xl\" data-kid=\"1-1-2-3-1-1-1\" style=\"color:#9a6a2e;width:22px;height:22px\">\n                        </i>\n                    </div>\n                    <div class=\"min-w-0\" data-kid=\"1-1-2-3-1-2\">\n                        <div class=\"flex flex-wrap items-center gap-2\" data-kid=\"1-1-2-3-1-2-1\">\n                            <span class=\"text-[10px] font-extrabold uppercase tracking-[0.15em] text-[#94642b]\" data-kid=\"1-1-2-3-1-2-1-1\">\n                                Aula de hoje\n                            </span>\n                            <span class=\"rounded-full bg-[#f5e4c5] px-2 py-0.5 text-[10px] font-bold text-[#865b29]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1-2-1-2\" data-name=\"attendance status badge\" data-reason=\"text/color updated when attendance status changes\">\n                                Chamada não concluída\n                            </span>\n                        </div>\n                        <div class=\"mt-1 text-[14px] font-bold text-[#3d392f]\" data-kid=\"1-1-2-3-1-2-2\">\n                            Futsal sub-14\n                            <span class=\"font-medium text-[#8a8070]\" data-dynamic=\"true\" data-kid=\"1-1-2-3-1-2-2-1\" data-name=\"next class time label\" data-reason=\"time string updated periodically\">\n                                · hoje, 10h\n                            </span>\n                        </div>\n                    </div>\n                </div>\n                <button class=\"flex shrink-0 items-center gap-2 rounded-xl bg-[#234e40] px-4 py-3 text-[12px] font-bold text-white shadow-[0_4px_10px_rgba(22,59,48,0.15)]\" data-kid=\"1-1-2-3-2\">\n                    <i class=\"ph ph-list-checks text-base\" data-kid=\"1-1-2-3-2-1\" style=\"color:#fff;width:18px;height:18px\">\n                    </i>\n                    Abrir chamada\n     