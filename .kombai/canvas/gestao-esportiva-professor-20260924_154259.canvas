ll bg-[#F6EBCF] text-[#876B2B] flex items-center justify-center text-sm font-bold\" data-kid=\"1-2-2-2-1-1-1\">\n                            !\n                        </div>\n                        <div data-kid=\"1-2-2-2-1-1-2\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-2-2-2-1-1-2-1\">\n                                <span class=\"text-[10px] font-bold tracking-[0.12em] uppercase text-[#9A7B39]\" data-kid=\"1-2-2-2-1-1-2-1-1\">\n                                    Atenção · hoje\n                                </span>\n                                <span class=\"rounded-full bg-[#F3E8CA] px-2 py-0.5 text-[10px] font-bold text-[#80652C]\" data-dynamic=\"true\" data-kid=\"1-2-2-2-1-1-2-1-2\" data-name=\"open attendance count badge\" data-reason=\"count updated based on live data\">\n                                    1 chamada aberta\n                                </span>\n                            </div>\n                            <h2 class=\"font-['Manrope',sans-serif] text-[16px] font-bold text-[#23383D] mt-1\" data-kid=\"1-2-2-2-1-1-2-2\">\n                                Hoje: 2 de 3 chamadas concluídas\n                            </h2>\n                            <p class=\"text-xs text-[#68787B] mt-1\" data-kid=\"1-2-2-2-1-1-2-3\">\n                                A próxima é\n                                <span class=\"font-semibold text-[#344B50]\" data-kid=\"1-2-2-2-1-1-2-3-1\">\n                                    Vôlei sub-13 · 14h · Quadra 2\n                                </span>\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex-1 xl:max-w-[500px] flex items-center gap-2\" data-kid=\"1-2-2-2-1-2\">\n                        <div class=\"flex-1 min-w-0 border-l-2 border-[#8CCBB1] pl-3 py-1\" data-kid=\"1-2-2-2-1-2-1\">\n                            <p class=\"text-[10px] uppercase tracking-wide text-[#839196]\" data-