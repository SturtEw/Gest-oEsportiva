      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap');\n</style>\n<div class=\"min-h-screen bg-[#f3f6f4] text-[#1b2a38]\" data-kid=\"1\" style=\"font-family:'DM Sans',sans-serif\">\n    <div class=\"min-h-screen grid grid-cols-[232px_minmax(0,1fr)]\" data-kid=\"1-1\">\n        <aside class=\"min-h-screen bg-[#132a3d] px-5 py-7 text-white flex flex-col\" data-kid=\"1-1-1\">\n            <div class=\"flex items-center gap-3 px-1\" data-kid=\"1-1-1-1\">\n                <div class=\"h-11 w-11 rounded-[14px] bg-[#b9ed73] text-[#173347] flex items-center justify-center font-extrabold tracking-[-1px] text-[15px]\" data-kid=\"1-1-1-1-1\" style=\"font-family:'Manrope',sans-serif\">\n                    GE\n                </div>\n                <div data-kid=\"1-1-1-1-2\">\n                    <p class=\"text-[10px] font-bold tracking-[.16em] text-[#b9ed73]\" data-kid=\"1-1-1-1-2-1\">\n                        GESTÃO\n                    </p>\n                    <p class=\"text-[13px] leading-[17px] font-semibold text-white\" data-kid=\"1-1-1-1-2-2\">\n                        Esportiva Escolar\n                    </p>\n                </div>\n            </div>\n            <div class=\"mt-11 px-2 text-[10px] font-bold uppercase tracking-[.14em] text-[#8da2b2]\" data-kid=\"1-1-1-2\">\n                Menu principal\n            </div>\n            <nav aria-label=\"Menu principal\" class=\"mt-3 space-y-1\" data-kid=\"1-1-1-3\">\n                <div class=\"flex items-center gap-3 rounded-xl bg-[#24465b] px-3 py-3 text-[13px] font-semibold text-white\" data-kid=\"1-1-1-3-1\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#b9ed73]\" data-kid=\"1-1-1-3-1-1\">\n                    </span>\n                    <span data-kid=\"1-1-1-3-1-2\">\n                        Painel do professor\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-3 rounded-xl px-3 py-3 text-[13px] font-medium text-[#c3d0d8]\" data-kid=\"1-1-1-3-2\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#688092]\" data-kid=\"1-1-1-3-2-1\">\n                    </span>\n                    <span data-kid=\"1-1-1-3-2-2\">\n                        Minhas turmas\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-3 rounded-xl px-3 py-3 text-[13px] font-medium text-[#c3d0d8]\" data-kid=\"1-1-1-3-3\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#688092]\" data-kid=\"1-1-1-3-3-1\">\n                    </span>\n                    <span data-kid=\"1-1-1-3-3-2\">\n                        Alunos\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-3 rounded-xl px-3 py-3 text-[13px] font-medium text-[#c3d0d8]\" data-kid=\"1-1-1-3-4\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#688092]\" data-kid=\"1-1-1-3-4-1\">\n                    </span>\n                    <span data-kid=\"1-1-1-3-4-2\">\n                        Avaliações\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-3 rounded-xl px-3 py-3 text-[13px] font-medium text-[#c3d0d8]\" data-kid=\"1-1-1-3-5\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#688092]\" data-kid=\"1-1-1-3-5-1\">\n                    </span>\n                    <span data-kid=\"1-1-1-3-5-2\">\n                        Comunicados\n                    </span>\n                </div>\n            </nav>\n            <div class=\"mt-auto rounded-2xl border border-[#355064] bg-[#183449] p-4\" data-kid=\"1-1-1-4\">\n                <div class=\"flex items-center justify-between\" data-kid=\"1-1-1-4-1\">\n                    <span class=\"text-[10px] uppercase tracking-[.14em] font-bold text-[#afc0c9]\" data-kid=\"1-1-1-4-1-1\">\n                        Período letivo\n                    </span>\n                    <span class=\"rounded-full bg-[#244d55] px-2 py-1 text-[10px] font-bold text-[#c8f18d]\" data-kid=\"1-1-1-4-1-2\">\n                        2026\n                    </span>\n                </div>\n                <p class=\"mt-3 text-[13px] font-semibold\" data-kid=\"1-1-1-4-2\">\n                    3º bimestre\n                </p>\n                <div class=\"mt-2 h-1.5 rounded-full bg-[#355064]\" data-kid=\"1-1-1-4-3\">\n                    <div class=\"h-1.5 w-[68%] rounded-full bg-[#b9ed73]\" data-kid=\"1-1-1-4-3-1\" data-name=\"period completion progress bar\">\n                    </div>\n                </div>\n                <p class=\"mt-2 text-[10px] text-[#afc0c9]\" data-kid=\"1-1-1-4-4\">\n                    Fechamento em 18 de outubro\n                </p>\n            </div>\n            <div class=\"mt-5 border-t border-[#355064] pt-5 flex items-center gap-3\" data-kid=\"1-1-1-5\">\n                <div class=\"h-9 w-9 rounded-full bg-[#f1c68d] text-[#442f24] flex items-center justify-center text-[12px] font-bold\" data-kid=\"1-1-1-5-1\">\n                    RF\n                </div>\n                <div class=\"min-w-0\" data-kid=\"1-1-1-5-2\">\n                    <p class=\"truncate text-[12px] font-semibold\" data-kid=\"1-1-1-5-2-1\">\n                        Rafael Farias\n                    </p>\n                    <p class=\"mt-0.5 text-[10px] text-[#a9bac5]\" data-kid=\"1-1-1-5-2-2\">\n                        Professor\n                    </p>\n                </div>\n                <span class=\"ml-auto text-[#9cb1bd] text-[18px]\" data-kid=\"1-1-1-5-3\">\n                    ···\n                </span>\n            </div>\n        </aside>\n        <main class=\"min-w-0 px-10 pb-10 pt-7 xl:px-12\" data-kid=\"1-1-2\">\n            <header class=\"flex items-center justify-between border-b border-[#e3e9e5] pb-5\" data-kid=\"1-1-2-1\">\n                <div class=\"flex items-center gap-2 text-[12px] text-[#7a8992]\" data-kid=\"1-1-2-1-1\">\n                    <span data-kid=\"1-1-2-1-1-1\">\n                        Quinta-feira\n                    </span>\n                    <span class=\"text-[#c3cec9]\" data-kid=\"1-1-2-1-1-2\">\n                        /\n                    </span>\n                    <span class=\"font-semibold text-[#344754]\" data-kid=\"1-1-2-1-1-3\">\n                        24 de setembro de 2026\n                    </span>\n                </div>\n                <div class=\"flex items-center gap-5\" data-kid=\"1-1-2-1-2\">\n                    <div class=\"relative rounded-full border border-[#e2e9e4] bg-white px-3.5 py-2 text-[11px] font-semibold text-[#566b77]\" data-kid=\"1-1-2-1-2-1\" data-name=\"central de avisos badge\">\n                        Central de avisos\n                        <span class=\"ml-2 inline-block h-1.5 w-1.5 rounded-full bg-[#e69b53] align-middle\" data-kid=\"1-1-2-1-2-1-1\">\n                        </span>\n                    </div>\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-1-2-2\">\n                        <div class=\"h-8 w-8 rounded-full bg-[#e9d9c3] flex items-center justify-center text-[10px] font-bold text-[#534435]\" data-kid=\"1-1-2-1-2-2-1\">\n                            RF\n                        </div>\n                        <span class=\"text-[12px] font-semibold text-[#334854]\" data-kid=\"1-1-2-1-2-2-2\">\n                            Rafael\n                        </span>\n                    </div>\n                </div>\n            </header>\n            <section class=\"mt-7 flex items-end justify-between\" data-kid=\"1-1-2-2\">\n                <div data-kid=\"1-1-2-2-1\">\n                    <p class=\"text-[11px] font-bold uppercase tracking-[.14em] text-[#64806e]\" data-kid=\"1-1-2-2-1-1\">\n                        Seu dia, no ritmo da turma\n                    </p>\n                    <h1 class=\"mt-1.5 text-[28px] font-extrabold tracking-[-1.1px] text-[#193347]\" data-kid=\"1-1-2-2-1-2\" style=\"font-family:'Manrope',sans-serif\">\n                        Bom dia, Rafael\n                    </h1>\n                    <p class=\"mt-1 text-[13px] text-[#71818a]\" data-kid=\"1-1-2-2-1-3\">\n                        Você tem 3 aulas hoje. A próxima começa às 10h.\n                    </p>\n                </div>\n                <div class=\"mb-1 flex items-center gap-2 rounded-xl border border-[#dfe8e2] bg-white px-3.5 py-2.5 text-[11px] font-semibold text-[#45606c]\" data-kid=\"1-1-2-2-2\">\n                    <span class=\"h-2 w-2 rounded-full bg-[#8fbe5e]\" data-kid=\"1-1-2-2-2-1\">\n                    </span>\n                    Quinta, 24 set\n                    <span class=\"ml-2 text-[#81929a]\" data-kid=\"1-1-2-2-2-2\">\n                        ⌄\n                    </span>\n                </div>\n            </section>\n            <section aria-label=\"Agenda de hoje\" class=\"mt-6 rounded-[20px] border border-[#e1e9e3] bg-white p-5 shadow-[0_4px_18px_rgba(25,51,71,0.035)]\" data-kid=\"1-1-2-3\">\n                <div class=\"mb-4 flex items-center justify-between\" data-kid=\"1-1-2-3-1\">\n                    <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-3-1-1\">\n                        <h2 class=\"text-[13px] font-bold text-[#203a4b]\" data-kid=\"1-1-2-3-1-1-1\">\n                            Agenda de hoje\n                        </h2>\n                        <span class=\"rounded-full bg-[#f0f4f0] px-2 py-1 text-[10px] font-semibold text-[#71827a]\" data-kid=\"1-1-2-3-1-1-2\">\n                            3 aulas\n                        </span>\n                    </div>\n                    <span class=\"text-[10px] text-[#87959b]\" data-kid=\"1-1-2-3-1-2\">\n                        Horários locais\n                    </span>\n                </div>\n                <div class=\"grid grid-cols-3 gap-3\" data-kid=\"1-1-2-3-2\">\n                    <div class=\"flex min-h-[91px] items-center gap-3 rounded-[14px] border border-[#e9eeeb] bg-[#fafcfb] px-4 py-3\" data-kid=\"1-1-2-3-2-1\">\n                        <div class=\"w-[45px] shrink-0\" data-kid=\"1-1-2-3-2-1-1\">\n                            <p class=\"text-[17px] font-bold tracking-[-.5px] text-[#354e5d]\" data-kid=\"1-1-2-3-2-1-1-1\" style=\"font-family:'Manrope',sans-serif\">\n                                08:00\n                            </p>\n                            <p class=\"mt-0.5 text-[9px] uppercase tracking-[.1em] text-[#9aa6a6]\" data-kid=\"1-1-2-3-2-1-1-2\">\n                                manhã\n                            </p>\n                        </div>\n                        <div class=\"h-10 w-px bg-[#dce5df]\" data-kid=\"1-1-2-3-2-1-2\">\n                        </div>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-3-2-1-3\">\n                            <p class=\"truncate text-[12px] font-bold text-[#324a59]\" data-kid=\"1-1-2-3-2-1-3-1\">\n                                Basquete sub-12\n                            </p>\n                            <p class=\"mt-1 text-[10px] text-[#85938f]\" data-kid=\"1-1-2-3-2-1-3-2\">\n                                12 alunos · Ginásio 1\n                            </p>\n                        </div>\n                        <span class=\"shrink-0 rounded-full bg-[#edf4ed] px-2 py-1 text-[9px] font-bold text-[#648265]\" data-kid=\"1-1-2-3-2-1-4\">\n                            Concluída\n                        </span>\n                    </div>\n                    <div class=\"relative flex min-h-[91px] items-center gap-3 rounded-[14px] border border-[#9bcc6f] bg-[#f4faed] px-4 py-3 ring-1 ring-[#d8edc4]\" data-kid=\"1-1-2-3-2-2\">\n                        <div class=\"absolute -top-2.5 left-4 rounded-full bg-[#9dcc6f] px-2.5 py-1 text-[9px] font-extrabold uppercase tracking-[.08em] text-[#183347]\" data-kid=\"1-1-2-3-2-2-1\" data-name=\"agenda current class tag\">\n                            Próxima aula\n                        </div>\n                        <div class=\"w-[45px] shrink-0\" data-kid=\"1-1-2-3-2-2-2\">\n                            <p class=\"text-[17px] font-extrabold tracking-[-.5px] text-[#18364a]\" data-kid=\"1-1-2-3-2-2-2-1\" style=\"font-family:'Manrope',sans-serif\">\n                                10:00\n                            </p>\n                            <p class=\"mt-0.5 text-[9px] uppercase tracking-[.1em] text-[#8a9b8a]\" data-kid=\"1-1-2-3-2-2-2-2\">\n                                manhã\n                            </p>\n                        </div>\n                        <div class=\"h-10 w-px bg-[#cfe1c4]\" data-kid=\"1-1-2-3-2-2-3\">\n                        </div>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-3-2-2-4\">\n                            <p class=\"truncate text-[12px] font-extrabold text-[#19394b]\" data-kid=\"1-1-2-3-2-2-4-1\">\n                                Futsal sub-14\n                            </p>\n                            <p class=\"mt-1 text-[10px] text-[#718276]\" data-kid=\"1-1-2-3-2-2-4-2\">\n                                18 alunos · Quadra coberta\n                            </p>\n                        </div>\n                        <span class=\"shrink-0 rounded-full bg-[#fff0d8] px-2 py-1 text-[9px] font-bold text-[#a0692c]\" data-kid=\"1-1-2-3-2-2-5\">\n                            Em andamento\n                        </span>\n                    </div>\n                    <div class=\"flex min-h-[91px] items-center gap-3 rounded-[14px] border border-[#e9eeeb] bg-[#fafcfb] px-4 py-3\" data-kid=\"1-1-2-3-2-3\">\n                        <div class=\"w-[45px] shrink-0\" data-kid=\"1-1-2-3-2-3-1\">\n                            <p class=\"text-[17px] font-bold tracking-[-.5px] text-[#354e5d]\" data-kid=\"1-1-2-3-2-3-1-1\" style=\"font-family:'Manrope',sans-serif\">\n                                14:00\n                            </p>\n                            <p class=\"mt-0.5 text-[9px] uppercase tracking-[.1em] text-[#9aa6a6]\" data-kid=\"1-1-2-3-2-3-1-2\">\n                                tarde\n                            </p>\n                        </div>\n                        <div class=\"h-10 w-px bg-[#dce5df]\" data-kid=\"1-1-2-3-2-3-2\">\n                        </div>\n                        <div class=\"min-w-0 flex-1\" data-kid=\"1-1-2-3-2-3-3\">\n                            <p class=\"truncate text-[12px] font-bold text-[#324a59]\" data-kid=\"1-1-2-3-2-3-3-1\">\n                                Vôlei sub-13\n                            </p>\n                            <p class=\"mt-1 text-[10px] text-[#85938f]\" data-kid=\"1-1-2-3-2-3-3-2\">\n                                16 alunos · Ginásio 2\n                            </p>\n                        </div>\n                        <span class=\"shrink-0 rounded-full bg-[#f1f3f2] px-2 py-1 text-[9px] font-bold text-[#78878a]\" data-kid=\"1-1-2-3-2-3-4\">\n                            Não iniciada\n                        </span>\n                    </div>\n                </div>\n            </section>\n            <section class=\"mt-5 grid grid-cols-[minmax(0,1.8fr)_minmax(275px,.82fr)] items-start gap-4\" data-kid=\"1-1-2-4\">\n                <div class=\"overflow-hidden rounded-[20px] border border-[#e0e8e3] bg-white shadow-[0_5px_20px_rgba(25,51,71,0.04)]\" data-kid=\"1-1-2-4-1\">\n                    <div class=\"flex items-start justify-between border-b border-[#edf1ee] px-5 pb-4 pt-5\" data-kid=\"1-1-2-4-1-1\">\n                        <div data-kid=\"1-1-2-4-1-1-1\">\n                            <div class=\"flex items-center gap-2\" data-kid=\"1-1-2-4-1-1-1-1\">\n                                <span class=\"h-2 w-2 rounded-full bg-[#93c45f]\" data-kid=\"1-1-2-4-1-1-1-1-1\">\n                                </span>\n                                <h2 class=\"text-[14px] font-extrabold text-[#1b384b]\" data-kid=\"1-1-2-4-1-1-1-1-2\" style=\"font-family:'Manrope',sans-serif\">\n                                    Chamada · Futsal sub-14\n                                </h2>\n                            </div>\n                            <p class=\"ml-4 mt-1.5 text-[10px] text-[#829095]\" data-kid=\"1-1-2-4-1-1-1-2\">\n                                Hoje, 10:00\n                                <span class=\"px-1.5 text-[#c4ceca]\" data-kid=\"1-1-2-4-1-1-1-2-1\">\n                                    ·\n                                </span>\n                                18 alunos na turma\n                            </p>\n                        </div>\n                        <button class=\"rounded-lg border border-[#e3eae5] px-3 py-2 text-[10px] font-semibold text-[#64777e]\" data-kid=\"1-1-2-4-1-1-2\">\n                            Ver turma\n                            <span class=\"ml-1\" data-kid=\"1-1-2-4-1-1-2-1\">\n                                ↗\n                            </span>\n                        </button>\n                    </div>\n                    <div class=\"flex items-center justify-between bg-[#f7faf7] px-5 py-3\" data-kid=\"1-1-2-4-1-2\">\n                        <div data-kid=\"1-1-2-4-1-2-1\">\n                            <p class=\"text-[11px] font-bold text-[#355164]\" data-kid=\"1-1-2-4-1-2-1-1\">\n                                15 de 18 presenças informadas\n                            </p>\n                            <p class=\"mt-0.5 text-[9px] text-[#889793]\" data-kid=\"1-1-2-4-1-2-1-2\">\n                                As 3 linhas sem registro continuam como “Não informado”.\n                            </p>\n                        </div>\n                        <div class=\"flex items-center gap-2.5\" data-kid=\"1-1-2-4-1-2-2\">\n                            <div class=\"h-1.5 w-[112px] overflow-hidden rounded-full bg-[#e1eae0]\" data-kid=\"1-1-2-4-1-2-2-1\">\n