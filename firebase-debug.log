[debug] [2026-09-30T00:43:00.582Z] <<< [apiv2][body] POST https://firebaserules.googleapis.com/v1/projects/gestaoesportiva-9d8fa/rulesets {"name":"projects/gestaoesportiva-9d8fa/rulesets/4baaf8f6-70dd-477e-ac93-2bc863b5130d","source":{"files":[{"content":"rules_version = '2';\nservice cloud.firestore {\n  match /databases/{database}/documents {\n\n    // ─── Negado por padrão ───────────────────────────────────────────────\n    // Qualquer coleção não explicitamente listada abaixo é inacessível.\n    // IMPORTANTE: em regras do Firestore, permissões se COMBINAM — se uma\n    // regra genérica autoriza, ela anula qualquer regra específica restritiva.\n    // Por isso, nada aqui pode usar `allow read, write: if true`.\n    match /{document=**} {\n      allow read, write: if false;\n    }\n\n    // ─── Perfil do usuário ───────────────────────────────────────────────\n    // Apenas o dono pode ler/criar/atualizar/deletar o próprio documento.\n    // O campo `userId` é imutável (não pode ser reatribuído a outro usuário).\n    match /users/{userId} {\n      allow read: if request.auth != null\n                  && request.auth.uid == userId;\n\n      allow create: if request.auth != null\n                    && request.auth.uid == userId\n                    && request.resource.data.userId == userId\n                    && request.resource.data.name is string\n                    && request.resource.data.name.size() > 0\n                    && request.resource.data.name.size() <= 100\n                    && request.resource.data.email is string\n                    && request.resource.data.email.matches('.*@.*\\\\..*')\n                    && (!request.resource.data.keys().hasAny(['role'])\n                        || request.resource.data.role == 'athlete'); // role sensível: só valores permitidos no signup\n\n      allow update: if request.auth != null\n                    && resource.data.userId == request.auth.uid\n                    && request.resource.data.userId == resource.data.userId\n                    && request.resource.data.name is string\n                    && request.resource.data.name.size() > 0\n                    && request.resource.data.name.size() <= 100;\n\n      allow delete: if request.auth != null\n                    && request.auth.uid == userId;\n    }\n\n    // ─── Treinos (workouts) ──────────────────────────────────────────────\n    // Cada usuário só vê e edita os próprios treinos.\n    match /workouts/{workoutId} {\n      allow read: if request.auth != null\n                  && resource.data.userId == request.auth.uid;\n\n      allow create: if request.auth != null\n                    && request.resource.data.userId == request.auth.uid\n                    && request.resource.data.title is string\n                    && request.resource.data.title.size() > 0\n                    && request.resource.data.title.size() <= 200\n                    && (!request.resource.data.keys().hasAny(['notes'])\n                        || request.resource.data.notes is string);\n\n      allow update, delete: if request.auth != null\n                    && resource.data.userId == request.auth.uid\n                    && request.resource.data.userId == resource.data.userId;\n    }\n\n    // ─── Treinos públicos (feed/comunidade) — apenas leitura ────────────\n    // Qualquer usuário autenticado pode ler, mas não escrever.\n    match /public_workouts/{workoutId} {\n      allow read: if request.auth != null;\n      allow write: if false; // escrita apenas via Admin SDK / Cloud Functions\n    }\n  }\n}\n","name":"firestore.rules"}]},"createTime":"2026-09-30T00:42:58.919952Z","metadata":{"services":["cloud.firestore"]}}
